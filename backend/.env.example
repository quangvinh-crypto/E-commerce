# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ecommerce

# Root Admin Seed (created automatically on server startup)
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=change_me_strong_password
ROOT_ADMIN_NAME=System Admin

# JWT Configuration
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=uploads

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Redis Configuration
# Redis URI duoc uu tien hon cau hinh host/port
# Vi du (Aiven TLS): rediss://default:your_password@your-host:21726
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CACHE_ENABLED=true
REDIS_DEFAULT_TTL=120
REDIS_KEY_PREFIX=ecommerce

# OpenSearch Configuration
OPENSEARCH_NODE=https://your-opensearch-host
OPENSEARCH_USERNAME=your_username
OPENSEARCH_PASSWORD=your_password

# VNPay Configuration
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payment/vnpay/return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRENCY=VND
VNPAY_LOCALE=vn
